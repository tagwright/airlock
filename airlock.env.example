# SPDX-License-Identifier: GPL-3.0-or-later
#
# Example airlock.env: AIRLOCK_* environment overrides and the env-var form
# of airlock's own alerting secrets. Copy to airlock.env and fill in what you
# need. docker-compose.yml loads it as an optional env_file, so an absent or
# empty file is fine.
#
# This file never carries a literal secret you intend to commit. Provision
# real values at deploy time (see docs/DEPLOY.md's SOPS recipe), and prefer
# the one-file-per-secret ./secrets/ mount over env vars where you can: an
# env var on a --privileged container is visible to anything that can exec
# into it or read its /proc/1/environ, a mounted file at least confines the
# value to what actually opens it.

# ---------------------------------------------------------------------------
# Beacon channel secrets (internal/secret's env fallback).
#
# Every credential value in airlock.yml's notifications/telemetry sections is
# a secret NAME, never a literal token. The resolver looks for
# /run/airlock/secrets/<name> first. If no such file exists, it falls back to
# AIRLOCK_SECRET_<NAME>, where <NAME> is <name> uppercased with "-" replaced
# by "_". Only set the ones your airlock.yml actually references.
#
# For the example airlock.yml's "ntfy-airlock-token" secret:
# AIRLOCK_SECRET_NTFY_AIRLOCK_TOKEN=

# For the example airlock.yml's "discord-airlock-webhook" secret:
# AIRLOCK_SECRET_DISCORD_AIRLOCK_WEBHOOK=

# For the example airlock.yml's "gatus-airlock-push-token" secret:
# AIRLOCK_SECRET_GATUS_AIRLOCK_PUSH_TOKEN=

# ---------------------------------------------------------------------------
# AIRLOCK_* fleet-wide tunables. Every one of these also has an airlock.yml
# "defaults" field of the same shape (see airlock.example.yml). The env var
# wins whenever both are set. Uncomment only what you want to override.

# AIRLOCK_OBSERVE=all
# AIRLOCK_DEFAULT_MODE=alert
# AIRLOCK_DEFAULT_SCOPE=external
# AIRLOCK_ALERT_WINDOW=1h
# AIRLOCK_ALERT_FLOOD=30
# AIRLOCK_DIGEST_SCHEDULE=0 0 * * *
# AIRLOCK_IMPLICIT_ALLOW=
# AIRLOCK_UNPOLICIED_DIGEST=false
# AIRLOCK_SECRETS_DIR=/run/airlock/secrets

# ---------------------------------------------------------------------------
# Daemon-owned operational knobs (no airlock.yml field of their own -- see
# internal/daemon's own doc comment for why these are env-only).

# Container runtime: "docker" (default) or "podman".
# AIRLOCK_RUNTIME=docker

# Override the runtime API socket path. Rarely needed: docker-compose.yml
# already mounts the conventional path for the selected runtime.
# AIRLOCK_SOCKET=

# How often the daemon pushes a healthy beacon Report for the Gatus
# dead-man's-switch leg. Go duration string. Default 5m.
# AIRLOCK_HEARTBEAT_INTERVAL=5m

# Where the daemon writes, and `airlock status`/`airlock suggest` read, the
# JSON state snapshot. docker-compose.yml already sets this to match its own
# tmpfs mount. Only change it if you changed that mount.
# AIRLOCK_STATE_PATH=/run/airlock/state/state.json

# How often the daemon refreshes the state snapshot. Go duration string.
# Default 5s.
# AIRLOCK_STATE_INTERVAL=5s

# Path to the host resolver config used for the implicit-allow resolver
# baseline. docker-compose.yml already sets this to reach the host's real
# resolv.conf through the /:/host mount. Only change it if you changed that
# mount.
# AIRLOCK_RESOLV_CONF=/host/etc/resolv.conf

# Override airlock's own container id (status/logging only -- this
# architecture has no self-exclusion). Best-effort auto-detected otherwise.
# AIRLOCK_SELF_ID=

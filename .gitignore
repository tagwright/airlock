# Build output
/airlock
/dist/
*.exe
*.test
*.out
*.prof

# Local dev
.env
*.local

# Never commit decrypted secrets or a live secrets dir
*.sops.decrypted
/run/
/secrets/

# Generated by test/integration/*.sh; the *.yml configs and *.sh scripts
# are committed, per-run captures/state are throwaway.
/test/integration/.capture-*/
/test/integration/.detect-state-*/
